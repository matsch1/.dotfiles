{
    // Window Settings
    "window.restoreWindows": "none", // Start with VS Code home screen
    "window.zoomLevel": 2, // Zoom level
    "breadcrumbs.enabled": true, // Show folder path at the top of the editor

    // Explorer Settings
    "explorer.autoReveal": true, // Automatically selects active file in explorer

    // Editor Settings
    "editor.wordWrap": "on", // Enable line wrapping in editor
    "editor.wordBasedSuggestions": "off", // Disable word-based suggestions
    "html.format.wrapLineLength": 100, // Line length for HTML formatting

    // Language-Specific Editor Settings
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [80],
        "editor.selectionHighlight": false,
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off"
    },
    "[dockerfile]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[python]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.wordBasedSuggestions": "off"
    },
    "[shellscript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },

    // File Associations
    "files.associations": {
        "*.jenkins": "groovy",
        "Dockerfile": "dockerfile"
    },

    // Extensions Settings
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },

    // Keyboard Settings
    "keyboard.dispatch": "keyCode", // For Caps Lock-Esc swap

    // Debugging Settings
    "launch": {
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
        }
    },

    // Security Settings
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],

    // Remote Development Settings
    "remote.autoForwardPortsSource": "hybrid",

    // Terminal Settings
    "terminal.integrated.commandsToSkipShell": [
        "matlab.interrupt"
    ]
}
